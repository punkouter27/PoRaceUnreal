+static inline int zmq_msg_init(zmq_msg_t*) { return 0; }
+static inline int zmq_msg_recv(zmq_msg_t*, void*, int) { return -1; }
+static inline int zmq_msg_close(zmq_msg_t*) { return 0; }
+static inline void* zmq_msg_data(zmq_msg_t* M) { return M->_; }
+static inline size_t zmq_msg_size(zmq_msg_t*) { return 0; }
diff --git a/Source/URLab/URLab.Build.cs b/Source/URLab/URLab.Build.cs
