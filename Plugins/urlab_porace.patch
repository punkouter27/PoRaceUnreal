+#define ZMQ_SUB 2
+#define ZMQ_REP 4
+#define ZMQ_SUBSCRIBE 6
+#define ZMQ_RCVMORE 13
+#define ZMQ_SNDHWM 23
+#define ZMQ_RCVTIMEO 27
+#define ZMQ_SNDTIMEO 28
+#define ZMQ_DONTWAIT 1
+#define ZMQ_SNDMORE 2
+
+typedef struct zmq_msg_t { unsigned char _[64]; } zmq_msg_t;
+
+static inline void* zmq_ctx_new(void) { return nullptr; }
+static inline int zmq_ctx_term(void*) { return 0; }
+static inline void* zmq_socket(void*, int) { return nullptr; }
+static inline int zmq_close(void*) { return 0; }
+static inline int zmq_setsockopt(void*, int, const void*, size_t) { return -1; }
+static inline int zmq_getsockopt(void*, int, void*, size_t*) { return -1; }
