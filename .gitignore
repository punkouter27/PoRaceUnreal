# Unreal
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
.vs/
*.sln
*.slnx
Plugins/*/Binaries/
Plugins/*/Intermediate/
Logs/

# URLab is vendored in Plugins/UnrealRoboticsLab (tracked; its Binaries/Intermediate are ignored above)

# Python / training
__pycache__/
*.pyc
.venv/
training/runs/
training/checkpoints/
training/logs/
MUJOCO_LOG.TXT

# Blender backups
*.blend1

# Web
Web/node_modules/
Web/dist/

# Parity replays are regenerated by training/parity_check.py make
training/replays/

# URLab's importer converts each .obj it imports to a .glb beside it
training/assets/**/*.glb
training/assets/**/*_ue.xml

# Local clone of the URLab plugin (own git repo, ~2.3 GB with build output); not part of this repo
Plugins/UnrealRoboticsLab/
